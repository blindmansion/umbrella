# Discord + Railway sandbox credentials
DISCORD_BOT_TOKEN=
RAILWAY_API_TOKEN=
RAILWAY_ENVIRONMENT_ID=
ANTHROPIC_API_KEY=
# Or use FIREWORKS_API_KEY instead of ANTHROPIC_API_KEY.
# GITHUB_TOKEN is optional, but recommended for private repositories.
GITHUB_TOKEN=
# OPENCODE_MODEL is optional.
OPENCODE_MODEL=
# GIT_AUTHOR_NAME / GIT_AUTHOR_EMAIL are optional commit identities for sandboxes.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# PostgreSQL state store. On Railway this is injected from the managed database;
# `railway run bun run dev` provides it automatically for local runs.
DATABASE_URL=

# Phoenix tracing (see README "Phoenix tracing").
# Base URL Railway sandboxes use to reach Phoenix. On Railway's private network
# use the Phoenix service's internal address, e.g.
#   PHOENIX_ENDPOINT=http://phoenix.railway.internal:6006
PHOENIX_ENDPOINT=
# System API key created in Phoenix. Required when Phoenix has auth enabled.
PHOENIX_API_KEY=
# Set to false to export span structure only, with prompts, responses, and tool
# input/output redacted. Defaults to true.
PHOENIX_LOG_CONTENT=
# Set to PRIVATE when the sandboxes share Phoenix's Railway private network.
SANDBOX_NETWORK_ISOLATION=

# TypeSafe intent classification (see README "Intent classification").
# When set, incoming messages are classified with TypeSafe jev so the bot can
# infer intent without requiring an explicit @mention or /task.
TYPESAFE_API_KEY=
# TYPESAFE_MODEL is optional and defaults to jev-latest.
TYPESAFE_MODEL=
# INTENT_CONFIDENCE_THRESHOLD is optional and defaults to 0.6.
INTENT_CONFIDENCE_THRESHOLD=

# Automatic cleanup of tasks whose linked issue or pull request closed.
# TASK_RECONCILE_INTERVAL_MINUTES is optional and defaults to 15. Set to 0 to disable.

# Web dashboard (see README "Configuration dashboard"). Both are required to
# enable the /configure command. DASHBOARD_SECRET is shared with the dashboard
# service and must be the same on both.
DASHBOARD_URL=
DASHBOARD_SECRET=
