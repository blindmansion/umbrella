# Discord + Railway sandbox credentials
DISCORD_BOT_TOKEN=
RAILWAY_API_TOKEN=
RAILWAY_ENVIRONMENT_ID=
ANTHROPIC_API_KEY=
# Or use FIREWORKS_API_KEY instead of ANTHROPIC_API_KEY.
# GITHUB_TOKEN is optional, but recommended for private repositories.
GITHUB_TOKEN=
# OPENCODE_MODEL is optional.
OPENCODE_MODEL=

# Phoenix tracing (see README "Tracing").
# URL the Railway sandboxes use to reach Phoenix. In production with the bot
# and Phoenix in the same Railway environment, use the private address:
#   PHOENIX_SANDBOX_ENDPOINT=http://phoenix.railway.internal:6006
# In development, expose the local `bun run dev` Phoenix container through a
# tunnel and put that URL here.
PHOENIX_SANDBOX_ENDPOINT=
# System API key created in Phoenix. Required when Phoenix has auth enabled.
PHOENIX_API_KEY=
# Set to PRIVATE when the sandboxes share Phoenix's Railway private network.
SANDBOX_NETWORK_ISOLATION=

# Production compose only (docker-compose.prod.yml)
PHOENIX_SECRET=
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=
