# PostgreSQL the bot and Electric share.
DATABASE_URL=

# Shared with the bot's DASHBOARD_SECRET. Signs magic links and session
# cookies and derives the key that encrypts stored GitHub tokens.
DASHBOARD_SECRET=

# Electric sync engine. On Railway this is the private service address.
ELECTRIC_URL=http://localhost:3000
ELECTRIC_SECRET=

# Port the dashboard listens on.
DASHBOARD_PORT=8787

# Set to true in production so auth cookies are Secure. The dashboard also
# defaults this to true when NODE_ENV=production.
DASHBOARD_SECURE_COOKIES=false
